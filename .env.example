# Example environment configuration for the muxe.org API.
#
# There is no .env loader (no dotenv dependency) — in production these are set
# by the systemd unit (deploy/muxe.service), and locally you export them or
# prefix the command. This file documents every variable the app reads; see
# src/config.ts for parsing and validation.

# TCP port to listen on. 0 lets the OS assign a free port (used by tests).
PORT=3000

# Interface to bind. Stays on localhost in production; Caddy reverse-proxies.
HOST=127.0.0.1

# Path to the SQLite database file. In production this points OUTSIDE the
# release dirs so it survives deploys (see deploy/muxe.service).
DB_PATH=./data/muxe.db

# Rate limiter for POST /reactions/:key (per client IP, token bucket).
# capacity = max burst; refill = sustained requests per second.
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=1
