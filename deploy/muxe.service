# systemd USER service for the muxe.org API.
#
# Install as the `deploy` user:
#   mkdir -p ~/.config/systemd/user
#   cp muxe.service ~/.config/systemd/user/muxe.service
#   loginctl enable-linger deploy          # run without an active login session
#   systemctl --user daemon-reload
#   systemctl --user enable --now muxe.service
#
# Runs the built app from the atomically-swapped `current` symlink.

[Unit]
Description=muxe.org REST API business card
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/muxe/current
ExecStart=/usr/bin/env node %h/muxe/current/dist/server.js
Restart=on-failure
RestartSec=2

# Bind to localhost only; Caddy reverse-proxies to this.
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=NODE_ENV=production

# Hardening for a user service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Allow writing only where the app lives (releases/current live under %h/muxe).
ReadWritePaths=%h/muxe

[Install]
WantedBy=default.target
