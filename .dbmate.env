# dbmate configuration for muxe.org.
#
# dbmate reads DATABASE_URL from this file (via --env-file) or the environment.
# For SQLite the URL is a path relative to this file's directory, unless
# absolute. In production DB_PATH points at a stable location outside the
# release dirs (see deploy/muxe.service); pass it through explicitly:
#
#   DATABASE_URL="sqlite:${DB_PATH}" dbmate up
#
# Locally, this default is used and creates ./data/muxe.db.
DATABASE_URL="sqlite:./data/muxe.db"
